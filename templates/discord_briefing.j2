{%- for n in fleet_node_data | default([]) -%}
{%- if not loop.first -%}{{ '\n\n' }}{%- endif -%}
**{{ n.node }}: ({{ n.status }})**
{%- if n.node != 'Ansible-Manager' -%}
{%- set node_lxcs = fleet_lxc_data | default([]) | selectattr('node', 'equalto', n.node) | list -%}
{%- set node_vms = fleet_vm_data | default([]) | selectattr('node', 'equalto', n.node) | list -%}
{%- for l in node_lxcs -%}{{ '\n' }}- {{ l.name }} ({{ l.id }}) — {{ l.app }}{% if l.os and l.os != 'None' %} | OS: {{ l.os }}{% endif %}{% if not l.snap %} *(no snap)*{% endif %}{%- endfor -%}
{%- for v in node_vms -%}{{ '\n' }}- VM {{ v.vmid }} {{ v.name }} — {{ v.status }}{%- endfor -%}
{%- if node_lxcs | length == 0 and node_vms | length == 0 -%}{{ '\n' }}- *No container changes.*{%- endif -%}
{%- endif -%}
{%- endfor %}
{%- set remote_hosts = fleet_remote_data | default([]) -%}
{%- if remote_hosts | length > 0 -%}{{ '\n\n' }}**Remote Hosts**{%- for r in remote_hosts -%}{{ '\n' }}- {{ r.host }} — {{ r.status }}{%- endfor -%}
{%- endif -%}
{%- if fleet_error_log is defined and fleet_error_log | length > 0 -%}{{ '\n\n' }}**Error Log:**{%- for e in fleet_error_log -%}{{ '\n' }}- **{{ e.host }}** failed at `{{ e.task }}`: `{{ e.error }}`{%- endfor -%}
{%- endif %}
