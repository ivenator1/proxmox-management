# Multi-cluster: with two or more Proxmox clusters, LXC/VM ids are NOT unique
# fleet-wide (each cluster can have its own 101). Tag each node with
# cluster=<name> (inline or in host_vars/<node>.yml) so discovery queries every
# cluster and same-id guests never cross-target. Nodes without a cluster= var
# all fall into one implicit "default" cluster — single-cluster setups need no
# changes. Node NAMES must stay unique across all clusters.
[proxmox_nodes]
pve-01 ansible_host=10.10.10.10
pve-02 ansible_host=10.10.10.20
# alpha-01 ansible_host=10.10.10.10 cluster=alpha
# beta-01  ansible_host=10.20.10.10 cluster=beta

# Nodes with NVIDIA GPUs: set nvidia_host=true to enable the read-only
# post-upgrade driver checks for that node (installed vs. loaded module
# version, DKMS state, nvidia-smi probe) — inline here or in
# host_vars/<node>.yml. The checks run from the Manager LXC over SSH on the
# node itself, never inside a workload LXC.
# gpu-node  ansible_host=10.30.10.10  nvidia_host=true

[proxmox_nodes:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_python_interpreter=/usr/bin/python3

# QEMU VMs managed by Proxmox (SSH-reachable).
# vmid must match the VM ID in PVE.
# pve_node is an optional fallback hint for non-cluster / non-HA setups. When
# the Python driver runs, it queries the Proxmox cluster via pvesh to find
# each VM's current node — HA migrations are handled automatically. pve_node
# is only used when cluster discovery is unavailable (e.g. standalone node).
# With multiple clusters, set cluster=<name> (or a pve_node in the right
# cluster) when the same vmid exists in more than one cluster — an ambiguous
# vmid fails loud rather than guessing.
# Leave the group empty (just the header) if you have no VMs.
[proxmox_vms]
# my-vm  ansible_host=10.10.10.50  vmid=200  pve_node=pve-01
# other  ansible_host=10.20.10.50  vmid=200  cluster=beta

[proxmox_vms:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_python_interpreter=/usr/bin/python3

# Non-Proxmox hosts (bare-metal, cloud VMs, etc.).
# No snapshot support. Supports apt, dnf, and apk (Alpine).
# Leave the group empty (just the header) if you have no remote hosts.
[remote_hosts]
# my-server  ansible_host=192.168.1.100

[remote_hosts:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_python_interpreter=/usr/bin/python3

# Non-standard systems updated via per-system YAML config files (configs/<name>.yml).
# Set custom_config=<name> per host to select the config file.
# Leave the group empty (just the header) if you have no custom systems.
#
# Optional per-host maintenance window (applies to remote_hosts, proxmox_vms, and
# custom_hosts — i.e. inventory hosts). The host is silently skipped outside it;
# pass -e force_window=true to bypass. Define in host_vars/<host>.yml:
#   maintenance_window:
#     days: ["Sat", "Sun"]   # optional; omit for any day
#     start: "02:00"
#     end: "04:00"           # may wrap past midnight
#     tz: "UTC"
#
# Optional dependency ordering: set depends_on (a list of other custom hostnames)
# in host_vars/<host>.yml. A host is skipped if any dependency FAILED this run.
# Phase 0b uses serial:1, so list dependencies BEFORE their dependents here;
# Phase 0a fails loudly if a dependent is listed before its dependency.
#   # host_vars/app-01.yml →  depends_on: ["db-01"]
[custom_hosts]
# db-01         ansible_host=10.0.0.59  custom_config=postgres
# gitea-server  ansible_host=10.0.0.60  custom_config=gitea

[custom_hosts:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_python_interpreter=/usr/bin/python3

# Appliances updated MANUALLY (initially TrueNAS SCALE and OPNsense). The
# fleet never applies updates to these; `fleet-update --scan` only runs the
# adapter's fixed read-only vendor checks and reminds you to use the GUI.
#
# Every host needs manual_adapter=<name>; supported
# names are validated by the scan, and a missing/blank adapter fails loudly at
# inventory load time, before any host is contacted.
#
# Overlap safety: a hostname here must NOT also appear in any auto-update group
# ([remote_hosts], [proxmox_vms], [custom_hosts], [proxmox_nodes]) — that
# overlap is rejected loudly so no machine is both manually and automatically
# updated. MIGRATION: moving a host from an auto-update group into
# [manual_update_hosts] is a one-line change (delete the old line, add it here
# with manual_adapter=) before running either scan or update.
#
# Optional per-host display_name (label for reports/reminders) and apply_hint
# (free-form note, e.g. when the update should be applied). Values containing
# spaces go in host_vars/<name>.yml (inline hosts.ini values must be single
# tokens):
#   # host_vars/truenas.yml →  display_name: "TrueNAS"
#   #                          apply_hint: "TrueNAS GUI → System Settings → Update"
#
# Optional HTTP-API transport: set manual_adapter=opnsense_api or
# truenas_scale_api to run the checks manager-side over the appliance REST API
# instead of SSH; the plain opnsense/truenas_scale (SSH) names above remain
# the default. Per-host vars (inline key=value or host_vars/<name>.yml, inline
# wins): api_url (blank → defaults to https://<ansible_host>), api_key (TrueNAS
# bearer token / OPNsense API key), api_secret (OPNsense only — key/secret
# pair), verify_ssl (default true; set verify_ssl=false for self-signed
# appliance certs). API credentials are secrets — keep them in hosts.ini
# (gitignored) or host_vars/ (gitignored), never in a committed file.
[manual_update_hosts]
# truenas  ansible_host=10.10.10.30  manual_adapter=truenas_scale
# firewall ansible_host=10.10.10.1   manual_adapter=opnsense
# API transport variants:
# firewall ansible_host=10.10.10.1   manual_adapter=opnsense_api  api_key=...  api_secret=...
# truenas  ansible_host=10.10.10.30  manual_adapter=truenas_scale_api  api_key=...  verify_ssl=false

[manual_update_hosts:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_python_interpreter=/usr/bin/python3
