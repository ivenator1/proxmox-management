---
# 'moderate' rather than 'strict': strict flags every shell: task lacking
# changed_when, but this project uses shell: for pct/vzdump which have no
# Ansible module equivalents — that is intentional, not a defect.
profile: moderate

warn_list:
  - yaml[line-length]
  - no-changed-when
  - jinja[spacing]        # cosmetic Jinja2 spacing in existing role code

skip_list:
  # Pre-existing code uses descriptive names (lxc_id, ct_script_name) rather
  # than the role-prefixed names ansible-lint expects (lxc_update_id, etc.).
  # Renaming all variables would be a breaking change to the playbook interface.
  - var-naming

  # Task names intentionally include {{ lxc_id }} / {{ vmid }} so Ansible's
  # output clearly shows which container is being processed.
  - name[template]

  # pct, vzdump, grep, and dpkg-query have no Ansible module equivalents —
  # shell: is the only option.
  - command-instead-of-module
  - command-instead-of-shell

  # include_tasks uses {{ playbook_dir }}/tasks/fleet-state-append.yml which
  # ansible-lint cannot resolve statically when processing role task files.
  - load-failure[not-found]

  # Some tasks intentionally use free-form shell syntax.
  - no-free-form

exclude_paths:
  - vars.yml
  - hosts.ini
  - .git/
  - tests/
  - roles/lxc_update/molecule/
  - roles/vm_update/molecule/
  - roles/remote_host_update/molecule/
