pve_api_user: "root@pam"
pve_api_token_id: "ansible"
pve_api_token_secret: "pve_api_token_secret" #Change with your api token secret
discord_webhook: "discord_webhook" #Change with your Discord Webook URL

# --- NOTIFIERS ---
# Pluggable notifier list. If omitted, the legacy `discord_webhook` above is used
# as a single Discord notifier (back-compat). Define `notifiers` to fan the same
# briefing out to multiple targets. Supported types: discord, ntfy, webhook, telegram.
# notifiers:
#   - type: discord
#     enabled: true
#     webhook: "{{ discord_webhook }}"
#   - type: ntfy
#     enabled: true
#     url: "https://ntfy.sh/my-fleet-topic"   # server + topic
#     token: ""                                # optional bearer token for protected topics
#     priority: 3                              # 1-5 (default: 5 on failure, else 3)
#     tags: "package"                          # optional ntfy tags/emoji
#   - type: webhook                            # generic JSON POST — Slack/Mattermost/HA/n8n intakes
#     enabled: true
#     url: "https://hooks.example.com/fleet"   # receives {title, body, failed, timestamp}
#     headers:                                 # optional extra HTTP headers
#       X-Api-Key: "secret"
#   - type: telegram
#     enabled: true
#     bot_token: "123456:ABC-bot-token"        # from @BotFather
#     chat_id: "-1001234567890"                # target chat/channel id
#     # parse_mode: ""                         # optional; default is plain text (briefing
#     #                                        # markdown is Discord-flavoured, not Telegram's)

#Apt-Cacher NG
apt_proxy_ip: "10.10.10.12" #Apt Procy IP
apt_proxy_port: 3142 #Apt Proxy Port

# Uptime Kuma Credentials
kuma_url: "http://10.10.10.13:3001" #URL of Uptime Kuma
kuma_user: "Username"
kuma_pass: "Password"
kuma_slug: "slug"

# Mapping: "LXC_ID": KUMA_MONITOR_ID
# Multi-cluster fleets may qualify a key as "cluster/LXC_ID" (e.g. "alpha/100")
# to override the monitor for just that cluster's container — an exact
# qualified key always wins over a bare-id key for the same vmid.
lxc_kuma_map:
  "100": "5" #Pi-Hole
  # "alpha/100": "9"   # overrides the Pi-Hole monitor only on cluster "alpha"

# --- CANARY / STAGED ROLLOUT ---
# Optional: update these hosts first (remote/lxc/vm phases). The rest of each
# phase runs only if no canary failed and — after the soak window — every
# Kuma-monitored canary is healthy; otherwise the remaining hosts are recorded
# as "SKIPPED (canary failed)". Entries are inventory names and/or LXC/VM ids;
# remote hosts and VMs can also be flagged with `canary=true` in hosts.ini or
# host_vars. Empty list = no staging (everything runs in one wave).
# In a multi-cluster fleet, qualify an id as "cluster/ID" (e.g. "alpha/101") to
# stage only that cluster's container/VM — a bare id still stages that id in
# every cluster (today's behaviour, for single-cluster fleets).
canary_hosts: []
# canary_hosts: ["101", "media-vm", "web-01", "alpha/101"]
canary_soak_minutes: 0      # wait this long after the canary wave before the Kuma check

# --- WEB DASHBOARD (fleet-dashboard) ---
# Optional web UI: pending updates, run history, run trigger. Install with
# `pip install -e '.[web]'` and start `fleet-dashboard` from the project root.
# Every page requires session login (admin account created by install.sh, or
# manually via `python -m proxmox_fleet.web.init_db`).
dashboard_host: "0.0.0.0"
dashboard_port: 8421

# --- PENDING-UPDATES SCAN (--scan) ---
# `fleet-update --scan` is read-only: it writes pending-<ts>.json +
# pending-latest.json to fleet_history_dir. Keep the newest N scan snapshots.
scan_history_keep: 30

# --- LXC TAG DISCOVERY ---
lxc_tags:
  - "community-script"
  - "proxmox-helper-scripts"

# --- BEHAVIOUR FLAGS ---
lxc_unattended: true       # sets PHS_SILENT=1 inside containers
lxc_dry_run: false         # compare versions only; no actual updates
lxc_auto_reboot: true      # reboot container when reboot-required is present
lxc_continue_on_error: false

# --- HEALTH WARNINGS (pre-emptive; never skip or fail a container) ---
# Warn when a container's rootfs is at/above this percentage. Kept below the
# community scripts' own >80% abort (check_container_storage) so a container is
# flagged a run or two before its app updates start failing with exit 114.
# Reported in the briefing's Warnings section, on --dry-run, and in --scan.
lxc_disk_warn_percent: 75

# --- RESOURCE SCALING (opt-in) ---
# Temporarily raise a container's cores/memory to its ct script's var_cpu/var_ram
# for the duration of the app update, then restore the live pre-scale values.
# Only ever fires on containers provisioned BELOW their script's spec (one the
# script created already matches). Off by default: the community scripts dropped
# build-time scaling, so enabling this adds `pct set` calls they no longer make.
# The plan is computed either way and shown under --verbose.
lxc_resource_scaling: false

# --- BACKUP STRATEGY ---
# snapshot | vzdump | both | none
lxc_backup_strategy: "snapshot"
# PVE storage name (set to your PBS storage name to route vzdump to PBS)
lxc_backup_storage: "local"

# --- KUMA MAPS FOR VMs AND REMOTE HOSTS ---
# "inventory_hostname": KUMA_MONITOR_ID
# Keyed by inventory name (already fleet-unique), so no "cluster/" qualifier
# is needed here — unlike lxc_kuma_map, which is keyed by vmid.
vm_kuma_map: {}
remote_kuma_map: {}

# --- CUSTOM SYSTEM SETTINGS ---
custom_dry_run: false

# --- FLEET-WIDE DRY RUN ---
# Master switch (usually passed as -e fleet_dry_run=true). Forces every role into
# its dry-run / simulate mode (no changes, no reboots) and forces a notification.
fleet_dry_run: false

# --- RUN HISTORY ---
# Each run writes <dir>/run-<UTC-timestamp>.json and overwrites <dir>/latest.json.
fleet_history_enabled: true
fleet_history_dir: "/var/log/fleet-update"
fleet_history_keep: 30          # keep the newest N run-*.json (0 = keep all)

# --- DEAD-MAN'S-SWITCH (optional) ---
# Pinged at the end of every run so its ABSENCE alerts you if the orchestrator
# stops running entirely. On failure, "<url>/fail" is pinged (healthchecks.io style).
# fleet_deadmans_url: "https://hc-ping.com/your-uuid"

# --- EXCLUSIONS ---
#LXC of managing node
# Multi-cluster fleets should qualify this as "cluster/ID" (e.g. "alpha/121")
# so the node-reboot-suppression check only matches the manager container on
# its own cluster; a bare ID (e.g. "121") matches that id in every cluster,
# same as before multi-cluster support.
manager_lxc_id: "alpha/121"

# List IDs you want to skip entirely (VMs or sensitive LXCs)
# Multi-cluster fleets may qualify an entry as "cluster/ID" (e.g. "alpha/103")
# to exclude that id only on one cluster; a bare id excludes it in every
# cluster, same as before multi-cluster support.
exclude_list:
  - "103" # prime95
  - "110" # EVE-NG
  - "100" # Pi-Hole
  # - "alpha/103" # prime95, cluster "alpha" only

# List of IDs to skip the 'apt/apk' OS update (accepts "cluster/ID" too)
os_update_exclude_list:
  - "120" #PBS

# List of tagged LXC IDs to skip the community-script app update for
# (the 'apt/apk' OS update still runs) — accepts "cluster/ID" too
app_update_exclude_list:
  - "xxx"

# List of untagged LXC IDs to manage for OS updates only — pulled into discovery
# even without the community-script tag (no /usr/bin/update; app reports "NO SCRIPT")
# Accepts "cluster/ID" to pull in an id on only one cluster.
os_only_lxc_list:
  - "xxx"

# List of IDs to update but not snapshot (accepts "cluster/ID" too)
snapshot_exclude_list:
  - "117" #Plex
  - "120" #PBS
