pve_api_user: "root@pam"
pve_api_token_id: "ansible"
pve_api_token_secret: "pve_api_token_secret" #Change with your api token secret

# Multi-cluster fleets: each cluster's API token normally lives on that
# cluster only, so the three pve_api_* values above may not work everywhere.
# pve_clusters overrides them per cluster (keyed by the same name used in
# each node's cluster= inventory var); any field left unset/empty falls back
# to the global pve_api_* value above. Single-cluster fleets can leave this
# unset entirely.
# pve_clusters:
#   alpha:
#     pve_api_user: "root@pam"
#     pve_api_token_id: "ansible"
#     pve_api_token_secret: "alpha_api_token_secret"
#   beta:
#     pve_api_user: "root@pam"
#     pve_api_token_id: "ansible"
#     pve_api_token_secret: "beta_api_token_secret"

discord_webhook: "discord_webhook" #Change with your Discord Webook URL

# --- NOTIFIERS ---
# Pluggable notifier list. If omitted, the legacy `discord_webhook` above is used
# as a single Discord notifier (back-compat). Define `notifiers` to fan the same
# briefing out to multiple targets. Supported types: discord, ntfy, webhook, telegram.
# notifiers:
#   - type: discord
#     enabled: true
#     webhook: "{{ discord_webhook }}"
#   - type: ntfy
#     enabled: true
#     url: "https://ntfy.sh/my-fleet-topic"   # server + topic
#     token: ""                                # optional bearer token for protected topics
#     priority: 3                              # 1-5 (default: 5 on failure, else 3)
#     tags: "package"                          # optional ntfy tags/emoji
#   - type: webhook                            # generic JSON POST — Slack/Mattermost/HA/n8n intakes
#     enabled: true
#     url: "https://hooks.example.com/fleet"   # receives {title, body, failed, timestamp}
#     headers:                                 # optional extra HTTP headers
#       X-Api-Key: "secret"
#   - type: telegram
#     enabled: true
#     bot_token: "123456:ABC-bot-token"        # from @BotFather
#     chat_id: "-1001234567890"                # target chat/channel id
#     # parse_mode: ""                         # optional; default is plain text (briefing
#     #                                        # markdown is Discord-flavoured, not Telegram's)

#Apt-Cacher NG
apt_proxy_ip: "10.10.10.12" #Apt Procy IP
apt_proxy_port: 3142 #Apt Proxy Port

# Uptime Kuma Credentials
kuma_url: "http://10.10.10.13:3001" #URL of Uptime Kuma
kuma_user: "Username"
kuma_pass: "Password"
kuma_slug: "slug"

# Mapping: "LXC_ID": KUMA_MONITOR_ID
# Multi-cluster fleets may qualify a key as "cluster/LXC_ID" (e.g. "alpha/100")
# to override the monitor for just that cluster's container — an exact
# qualified key always wins over a bare-id key for the same vmid.
lxc_kuma_map:
  "100": "5" #Pi-Hole
  # "alpha/100": "9"   # overrides the Pi-Hole monitor only on cluster "alpha"

# --- CANARY / STAGED ROLLOUT ---
# Optional: update these hosts first (remote/lxc/vm phases). The rest of each
# phase runs only if no canary failed and — after the soak window — every
# Kuma-monitored canary is healthy; otherwise the remaining hosts are recorded
# as "SKIPPED (canary failed)". Entries are inventory names and/or LXC/VM ids;
# remote hosts and VMs can also be flagged with `canary=true` in hosts.ini or
# host_vars. Empty list = no staging (everything runs in one wave).
# In a multi-cluster fleet, qualify an id as "cluster/ID" (e.g. "alpha/101") to
# stage only that cluster's container/VM — a bare id still stages that id in
# every cluster (today's behaviour, for single-cluster fleets).
canary_hosts: []
# canary_hosts: ["101", "media-vm", "web-01", "alpha/101"]
canary_soak_minutes: 0      # wait this long after the canary wave before the Kuma check

# --- WEB DASHBOARD (fleet-dashboard) ---
# Optional web UI: pending updates, run history, run trigger. Install with
# `pip install -e '.[web]'` and start `fleet-dashboard` from the project root.
# Every page requires session login (admin account created by install.sh, or
# manually via `python -m proxmox_fleet.web.init_db`).
dashboard_host: "0.0.0.0"
dashboard_port: 8421

# --- PENDING-UPDATES SCAN (--scan) ---
# `fleet-update --scan` is read-only: it writes pending-<ts>.json +
# pending-latest.json to fleet_history_dir. Keep the newest N scan snapshots.
scan_history_keep: 30

# --- MANUAL UPDATE TRACKING ---
# Hosts listed in [manual_update_hosts] are never auto-updated. Scans check them
# read-only and refresh state/dashboard data without notifying. Due first/change
# notices and reminders piggyback on the next fleet briefing. These settings are
# NOT accepted as -e extra vars.
manual_update_notifications: true
manual_update_reminder_hours: 24
manual_update_forks: 2
# Per-request timeout for the HTTP-API manual checks (manual_adapter=*_api).
# OPNsense's firmware/status check hits update mirrors synchronously and can
# exceed the default 30s. Scan-only, not accepted as an -e extra var.
manual_update_api_timeout: 120

# --- GRAFANA ALLOY GUEST COMPLIANCE (opt-in) ---
# Copy configs/guest.alloy.example to configs/guest.alloy, replace the
# REPLACE_WITH_LOKI_ENDPOINT placeholder, then enable enforcement. The real
# *.alloy file is gitignored because it may contain private network details.
alloy_enabled: false
alloy_config_path: "configs/guest.alloy"
# Bare LXC ids apply fleet-wide; qualify cluster/ID for one cluster. Exclude
# log receivers and any guest with a purpose-specific Alloy config.
lxc_alloy_exclude_list: []
# VM exclusions are stable [proxmox_vms] inventory names, not collision-prone vmids.
vm_alloy_exclude_list: []

# --- APPLICATION-LOG CATALOGUE (managed LXCs) ---
# Managed LXCs get live file sources from the packaged declarative manifests in
# proxmox_fleet/log_catalogue/ (27 apps + 7 reusable dependencies; see the
# README section "Application-log catalogue"). Each manifest declares its exact
# community-script identity, journal units, layouts, optional includes and
# optional disk-ratio metadata. Auto selection is the default: there is no
# hostname/service-name guessing, and supported apps need no per-guest entry.
# Manifests are data only (no shell commands, HCL, templates, downloads or
# archive/deletion rights); a local file may not shadow a built-in id.
# alloy_log_plugins_dir is optional and is strictly ADDITIVE to the packaged
# manifests. Per-guest overrides are raw YAML and are not edited by the
# dashboard's structured settings form. Includes are declared in the manifest
# itself (for example firecrawl includes postgresql, rabbitmq and redis), never
# in vars.yml.
alloy_log_plugins_auto: true
alloy_log_plugins_dir: null      # e.g. "/root/proxmox-management/log-plugins"
alloy_log_overrides: {}
# Override keys use the full THREE-segment "cluster/node/id" (a bare numeric id
# is also accepted only when unambiguous fleet-wide; an ambiguous bare key is
# rejected before any mutation). This is NOT the two-segment "cluster/id" form
# used by --limit and housekeeping_timer_targets. Modes: auto (identity-based,
# may adjust sources/locations/layouts), replace (only listed plugins; auto
# ignored), extend (auto plus plugins, minus disable_plugins), disabled (base
# journal config only, no other fields).
# alloy_log_overrides:
#   "default/pve01/135":
#     mode: auto
#     # locations replaces paths only within that source's own audited roots,
#     # alternate roots or exact-file list; settings never widen access.
#     locations:
#       homepage/application:
#         - /opt/homepage/.next/standalone/config/logs/homepage.log
#   "default/pve01/128":
#     mode: auto
#     disable_sources:                 # owner/source or owner/dependency/source
#       - firecrawl/redis/cache-service
#   "default/pve01/109":
#     mode: replace
#     plugins: [prowlarr]              # explicit selection; auto identity ignored
#   "default/pve01/118":
#     mode: disabled                   # journal-only base, no file readers

# Safe rollout after enabling/configuring:
#   ./fleet-update.py --dry-run --alloy-only
#   ./fleet-update.py --alloy-only --limit 101,media-vm
#   ./fleet-update.py --alloy-only

# --- LOG HOUSEKEEPING FOR MANAGED LXCs (opt-in) ---
# Collects supported applications' live logs in Loki from the declarative
# catalogue (journal units plus audited files); Nginx Proxy Manager (NPM) and
# Proxmox Backup Server (PBS) additionally keep the acknowledged archive/import
# path and gated local file pruning. Also runs recurring native cache cleanup
# for the fixed allowlisted profiles APT, Yarn, npm, pnpm and Bun (no custom
# paths or commands); only a successful native command advances the cadence.
# Ordinary LXC runs opt in with housekeeping_enabled; `--housekeeping-only`
# requests the same feature explicitly (no updates, snapshots or reboots).
#
# housekeeping_loki_url is the canonical base the manager appends
# /loki/api/v1/... to — an absolute http(s) URL with no credentials, query or
# fragment. Secrets stay in real configuration, never in CLI output. It is
# REQUIRED whenever housekeeping is requested (housekeeping_enabled: true or an
# explicit --housekeeping-only run).
housekeeping_enabled: false
housekeeping_loki_url: ""        # e.g. "http://loki.example.lan:3100" (no trailing path)
# Closed-file retention cutoff for the NPM/PBS archive profiles (the desired
# Alloy journal age limit is aligned separately). New live-only application
# sources are never pruned by the fleet.
housekeeping_local_retention_hours: 48
# Fleet-owned journald drop-in bounds (MB): hard local budget and keep-free floor.
housekeeping_journal_max_mb: 256
housekeeping_journal_keep_free_mb: 512
# Cache-cleanup cadence, independent of the hourly log tick. Tools and roots are
# fixed (APT, Yarn, npm, pnpm, Bun). Bun uses only the freshly resolved binary's
# native `bun pm cache prune --max-age 30` under /root/.bun/install/cache with
# BUN_INSTALL_CACHE_DIR pinned, and only when a bounded `bun pm --help` probe
# advertises prune plus --max-age. Per-entry age is max(atime, mtime); the
# metadata probe opens directories with O_NOATIME so it does not refresh them.
# links/, git clones and manifests are retained; `bun pm cache rm` and Bun
# upgrades are never used, and an unsupported binary is skipped rather than
# cleaned destructively. Busy/failed/unsupported results change neither files
# nor cadence; only a successful native command advances it (same setting for
# every tool).
housekeeping_cache_interval_hours: 24
# Max acknowledged archive payload per NPM/PBS guest per run (MiB); import
# resumes on later runs until every initial file prefix is acknowledged.
housekeeping_backfill_budget_mb: 1024
# Bare LXC ids apply fleet-wide; qualify cluster/ID for one cluster. Matches
# matches_any() like the other exclusion lists.
lxc_housekeeping_exclude_list: []
#
# The installer schedules an hourly fleet-housekeeping.timer that runs
# `fleet-update --housekeeping-only`. Leave housekeeping_timer_enabled unset
# (null) to keep the legacy behaviour where the timer follows
# housekeeping_enabled; set it true to schedule maintenance while ordinary LXC
# updates stay opted out (housekeeping_enabled: false), or false to always
# disable the timer. Enabling the timer still requires housekeeping_loki_url.
housekeeping_timer_enabled: null
# Optional targets for the scheduled run, written as one `--limit` value: bare
# ids or the two-segment "cluster/id" form (this is NOT the three-segment
# "cluster/node/id" override key used by alloy_log_overrides). Empty keeps the
# legacy whole-fleet schedule, e.g. [default/101, beta/102]. Discovery is not
# enrollment: after changing targets, rerun `install.sh --update` so the
# service's generated ExecStart --limit is regenerated, then observe a natural
# scheduled run reclaim a genuinely due cache before relying on it.
housekeeping_timer_targets: []

# --- LXC TAG DISCOVERY ---
lxc_tags:
  - "community-script"
  - "proxmox-helper-scripts"

# --- BEHAVIOUR FLAGS ---
lxc_unattended: true       # sets PHS_SILENT=1 inside containers
lxc_dry_run: false         # compare versions only; no actual updates
lxc_auto_reboot: true      # reboot container when reboot-required is present
lxc_continue_on_error: false

# --- DISK SAFETY (percentage AND absolute free space) ---
# A rootfs is low only when it is at/above this percentage AND has less than
# lxc_disk_min_free_gb available. This avoids false alarms on large roots (for
# example, 90% of 200 GiB still leaves 20 GiB free). When /boot exceeds the
# community scripts' hard 80% guard but meets the absolute minimum, the fleet
# updater filters only that guard call from the fetched ct script stream; the
# installed /usr/bin/update wrapper and upstream source are never modified.
# Reported in the briefing's Warnings section, on --dry-run, and in --scan.
# When this warning already fires, the run also appends one bounded read-only
# breakdown of the guest's USED rootfs space (largest directories as shares of
# used bytes, every mounted subtree excluded). It is diagnostic only: no new
# alert/notification, periodic sweep, cleanup entitlement or scan/housekeeping
# work. Expected-normal caps are generic 20% with a 256 MiB floor (/usr: 85%),
# and a service manifest may override them under its own `disk_usage` metadata
# (including relaxing an expected-normal high-data ratio), via
# default_max_share_percent / min_directory_mb / path_max_share_percent.
lxc_disk_warn_percent: 75
lxc_disk_min_free_gb: 10

# --- RESOURCE SCALING (opt-in) ---
# Temporarily raise a container's cores/memory to its ct script's var_cpu/var_ram
# for the duration of the app update, then restore the live pre-scale values.
# Only ever fires on containers provisioned BELOW their script's spec (one the
# script created already matches). Off by default: the community scripts dropped
# build-time scaling, so enabling this adds `pct set` calls they no longer make.
# The plan is computed either way and shown under --verbose.
lxc_resource_scaling: false

# --- BACKUP STRATEGY ---
# snapshot | vzdump | both | none
lxc_backup_strategy: "snapshot"
# Large disks or slow storage can exceed community.proxmox's 30-second default.
snapshot_timeout: 600       # overall create/delete operation wait
snapshot_api_timeout: 30    # timeout for each Proxmox API request
# PVE storage name (set to your PBS storage name to route vzdump to PBS)
lxc_backup_storage: "local"

# --- KUMA MAPS FOR VMs AND REMOTE HOSTS ---
# "inventory_hostname": KUMA_MONITOR_ID
# Keyed by inventory name (already fleet-unique), so no "cluster/" qualifier
# is needed here — unlike lxc_kuma_map, which is keyed by vmid.
vm_kuma_map: {}
remote_kuma_map: {}

# --- CUSTOM SYSTEM SETTINGS ---
custom_dry_run: false

# --- FLEET-WIDE DRY RUN ---
# Master switch (usually passed as -e fleet_dry_run=true). Forces every role into
# its dry-run / simulate mode (no changes, no reboots) and forces a notification.
fleet_dry_run: false

# --- RUN HISTORY ---
# Each run writes <dir>/run-<UTC-timestamp>.json and overwrites <dir>/latest.json.
fleet_history_enabled: true
fleet_history_dir: "/var/log/fleet-update"
fleet_history_keep: 30          # keep the newest N run-*.json (0 = keep all)
# Keep exact per-record OS package detail (the `packages` lists) only on the
# newest N run files; older timestamped runs are stripped in place. 0 = keep
# it on every run. latest.json and totals.json are never affected.
fleet_package_detail_keep: 7

# --- DEAD-MAN'S-SWITCH (optional) ---
# Pinged at the end of every run so its ABSENCE alerts you if the orchestrator
# stops running entirely. On failure, "<url>/fail" is pinged (healthchecks.io style).
# fleet_deadmans_url: "https://hc-ping.com/your-uuid"

# --- EXCLUSIONS ---
#LXC of managing node
# Multi-cluster fleets should qualify this as "cluster/ID" (e.g. "alpha/121")
# so the node-reboot-suppression check only matches the manager container on
# its own cluster; a bare ID (e.g. "121") matches that id in every cluster,
# same as before multi-cluster support.
manager_lxc_id: "alpha/121"

# List IDs you want to skip entirely (VMs or sensitive LXCs)
# Multi-cluster fleets may qualify an entry as "cluster/ID" (e.g. "alpha/103")
# to exclude that id only on one cluster; a bare id excludes it in every
# cluster, same as before multi-cluster support.
exclude_list:
  - "103" # prime95
  - "110" # EVE-NG
  - "100" # Pi-Hole
  # - "alpha/103" # prime95, cluster "alpha" only

# List of IDs to skip the 'apt/apk' OS update (accepts "cluster/ID" too)
os_update_exclude_list:
  - "120" #PBS

# List of tagged LXC IDs to skip the community-script app update for
# (the 'apt/apk' OS update still runs) — accepts "cluster/ID" too
app_update_exclude_list:
  - "xxx"

# List of untagged LXC IDs to manage for OS updates only — pulled into discovery
# even without the community-script tag (no /usr/bin/update; app reports "NO SCRIPT")
# Accepts "cluster/ID" to pull in an id on only one cluster.
os_only_lxc_list:
  - "xxx"

# List of IDs to update but not snapshot (accepts "cluster/ID" too)
snapshot_exclude_list:
  - "117" #Plex
  - "120" #PBS

# --- NODE POST-UPGRADE CHECKS (NVIDIA) ---
# Proxmox nodes flagged nvidia_host=true (inline in hosts.ini or in
# host_vars/<node>.yml) get read-only GPU-driver diagnostics after their node
# OS update. The checks run from the Manager LXC over Ansible SSH on the node
# itself — never inside a workload LXC:
#   * target vs. loaded NVIDIA module mismatch     → node reboot required
#   * missing modules/DKMS for next-boot kernel    → hard failure (node FAILED)
#   * nvidia-smi fails after the reboot             → hard failure (node FAILED)
# node_auto_reboot governs ALL node reboots. Default true = auto-reboot when
# needed; false = controlled/manual maintenance: nodes needing a reboot report
# "UPDATED (MANUAL REBOOT REQ)" and are never rebooted automatically. The node
# hosting the Manager LXC is never rebooted in either case.
node_auto_reboot: true
